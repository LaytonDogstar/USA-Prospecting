# Copy to .env and fill in. .env is ignored by git.
# Old SQLite tool (src/prospecting): paths default to ./data and ./output if unset.
PROSPECTING_DATA_DIR=./data
PROSPECTING_OUTPUT_DIR=./output

# Ecosystem app (src/ecosystem). Railway sets DATABASE_URL itself.
DATABASE_URL=postgresql://postgres@localhost:5433/ecosystem
TEST_DATABASE_URL=postgresql://postgres@localhost:5433/ecosystem_test
ECOSYSTEM_DATA_DIR=./data
